# Read-only exchange research worker; no credentials needed for market data.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
WORKDIR /app
COPY paper_backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && useradd -u 10001 -m sentinel \
    && mkdir -p /app/state \
    && chown -R sentinel:sentinel /app
COPY --chown=sentinel:sentinel paper_backend/sentinel /app/sentinel
USER sentinel
ENV SENTINEL_STATE_DIR=/app/state
HEALTHCHECK --interval=5m --timeout=15s --start-period=3m --retries=3 \
  CMD python -m sentinel.exchange_worker healthcheck
CMD ["python","-m","sentinel.exchange_worker","--forever"]
